# Override GitHub Linguist language detection for R package
*.Rd linguist-language=R
*.bib linguist-documentation
inst/extdata/* linguist-vendored
docs/* linguist-vendored
*.csv linguist-generated
*.tsv linguist-generated
*.tree linguist-generated
*.tre linguist-generated
*.support linguist-generated
*.pdf linguist-generated
*.jpg linguist-generated
*.png linguist-generated
*.svg linguist-generated


# Distributed data and figures: never convert line endings, so that their md5 match PROVENANCE.csv and annex C on every platform (git on Windows turns LF into CRLF otherwise)
inst/extdata/** -text
extended_trees/** -text
